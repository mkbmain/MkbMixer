<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are executables, run by dotnet test through
         Microsoft.Testing.Platform (opted into in global.json). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mkb.Mixer.Audio\Mkb.Mixer.Audio.csproj" />
    <ProjectReference Include="..\..\src\Mkb.Mixer.Library\Mkb.Mixer.Library.csproj" />
    <ProjectReference Include="..\..\src\Mkb.Mixer.App\Mkb.Mixer.App.csproj" />
  </ItemGroup>

</Project>