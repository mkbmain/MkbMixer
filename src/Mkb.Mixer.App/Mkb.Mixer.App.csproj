    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mkb.Mixer.Audio\Mkb.Mixer.Audio.csproj" />
    <ProjectReference Include="..\Mkb.Mixer.Library\Mkb.Mixer.Library.csproj" />
  </ItemGroup>
</Project>
