<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shared UI. Mkb.Mixer.App.Desktop and Mkb.Mixer.App.Android are the
       platform entry points that host it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mkb.Mixer.Audio\Mkb.Mixer.Audio.csproj" />
    <ProjectReference Include="..\Mkb.Mixer.Library\Mkb.Mixer.Library.csproj" />
  </ItemGroup>
</Project>
