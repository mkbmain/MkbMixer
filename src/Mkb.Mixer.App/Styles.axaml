<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:Mkb.Mixer.App.Controls"
        xmlns:views="using:Mkb.Mixer.App.Views">
  <Styles.Resources>
    <!-- Gold is the one deliberate carry-over from the original's black-and-gold chrome. -->
    <Color x:Key="AccentColor">#FFC83C</Color>
    <SolidColorBrush x:Key="Accent" Color="#FFC83C" />
    <SolidColorBrush x:Key="Live" Color="#3CD070" />
    <SolidColorBrush x:Key="Muted" Color="#E05050" />
    <SolidColorBrush x:Key="PanelBg" Color="#16181C" />
    <SolidColorBrush x:Key="PanelBorder" Color="#2A2E36" />
    <SolidColorBrush x:Key="WindowBg" Color="#0E1013" />
    <SolidColorBrush x:Key="Dim" Color="#8A90A0" />
  </Styles.Resources>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LetterSpacing" Value="2" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.time">
    <Setter Property="FontFamily" Value="monospace" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#D8DCE4" />
  </Style>

  <Style Selector="TextBlock.nowplaying">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#F0F2F6" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Button.transport">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tiny">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="ToggleButton.decktoggle">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ctrl|WaveformView.deck">
    <Setter Property="Height" Value="72" />
  </Style>

  <!-- Deck layout values live here rather than on the elements, so the touch
       styles below can override them. -->
  <Style Selector="TextBlock.nowplaying">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Margin" Value="0,8,0,6" />
  </Style>

  <Style Selector="Grid.times">
    <Setter Property="Grid.Row" Value="3" />
    <Setter Property="Margin" Value="0,4,0,10" />
  </Style>

  <Style Selector="ListBox.playlist">
    <Setter Property="MinHeight" Value="120" />
  </Style>

  <Style Selector="Slider.tempo">
    <Setter Property="Width" Value="130" />
  </Style>

  <!-- Shows the tempo and resets it on tap. Fixed width so the slider doesn't
       shift as the number changes. -->
  <Style Selector="Button.temporeset">
    <Setter Property="Width" Value="52" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="monospace" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Tablet. The deck row sizes to its content, which left the library only a
       couple of rows, so on touch the deck folds its title into the header row and
       its times into the transport row, and caps the playlist at about three tracks. -->
  <Style Selector=".touch TextBlock.nowplaying">
    <Setter Property="Grid.Row" Value="0" />
    <!-- Clears the deck name on the left and the LIVE/MUTE toggle on the right. -->
    <Setter Property="Margin" Value="96,0,72,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector=".touch ctrl|WaveformView.deck">
    <Setter Property="Height" Value="48" />
  </Style>

  <Style Selector=".touch Grid.times">
    <Setter Property="Grid.Row" Value="4" />
    <!-- Sits between the transport buttons and the tempo slider, both fixed width. -->
    <Setter Property="Margin" Value="150,0,210,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector=".touch ListBox.playlist">
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="MaxHeight" Value="96" />
  </Style>

  <Style Selector=".touch ListBox.playlist ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <!-- Fluent's scroll bars are thin and fade out, which leaves nothing to grab with
       a finger. Keep them shown and wide enough to drag. -->
  <Style Selector=".touch ScrollBar">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>

  <!-- DataGrid draws its own scroll bars rather than using a ScrollViewer, and
       takes the auto-hide setting from this attached property. -->
  <Style Selector=".touch DataGrid">
    <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    <Setter Property="IsScrollInertiaEnabled" Value="True" />
  </Style>

  <!-- Phone. PhoneView carries both "touch" and "phone", so these come after the
       tablet styles to override them. The deck is too narrow to fold its title and
       times into the other rows, but it has the height, because its playlist moves
       to a tab of its own. -->
  <Style Selector=".phone TextBlock.nowplaying">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Margin" Value="0,6,0,6" />
  </Style>

  <Style Selector=".phone ctrl|WaveformView.deck">
    <Setter Property="Height" Value="56" />
  </Style>

  <Style Selector=".phone Grid.times">
    <Setter Property="Grid.Row" Value="3" />
    <Setter Property="Margin" Value="0,4,0,8" />
  </Style>

  <Style Selector=".phone Button.transport">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="44" />
  </Style>

  <!-- Narrower so the tempo reset button still fits beside it. -->
  <Style Selector=".phone Slider.tempo">
    <Setter Property="Width" Value="86" />
  </Style>

  <Style Selector=".phone views|PlaylistView.deckplaylist">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- On the playlists tab each list fills its half of the screen. -->
  <Style Selector=".phone ListBox.playlist">
    <Setter Property="MaxHeight" Value="Infinity" />
  </Style>

  <Style Selector=".phone Button.tiny">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector=".phone ListBox.tracks ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="TabControl.phonetabs TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <Style Selector="TabControl.phonetabs TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
</Styles>
