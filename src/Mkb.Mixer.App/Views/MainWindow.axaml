<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mkb.Mixer.App.ViewModels"
        xmlns:views="using:Mkb.Mixer.App.Views"
        x:Class="Mkb.Mixer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MKB Music Mixer"
        Icon="/Assets/mkb-mixer.ico"
        Width="1280" Height="840" MinWidth="900" MinHeight="680"
        Background="{StaticResource WindowBg}">

  <views:MainView />
</Window>
