<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mkb.Mixer.App.ViewModels"
             xmlns:views="using:Mkb.Mixer.App.Views"
             x:Class="Mkb.Mixer.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource WindowBg}">

  <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto">

    <!-- Decks -->
    <Grid Grid.Row="0" ColumnDefinitions="*,10,*">
      <views:DeckView DataContext="{Binding DeckA}" />
      <views:DeckView Grid.Column="2" DataContext="{Binding DeckB}" />
    </Grid>

    <!-- Mixer: crossfader plus auto-cue -->
    <Border Grid.Row="1" Classes="panel" Margin="0,10,0,0">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Classes="heading" Text="A" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="1" Margin="12,0"
                Value="{Binding CrossfaderPosition}"
                ToolTip.Tip="Crossfader. Constant-power curve, so loudness stays steady across the fade." />
        <TextBlock Grid.Column="2" Classes="heading" Text="B" VerticalAlignment="Center" />

        <CheckBox Grid.Column="3" Margin="24,0,0,0" Content="auto-cue"
                  IsChecked="{Binding AutoCueEnabled}"
                  ToolTip.Tip="Automatically fade to the other deck as a track runs out." />

        <TextBlock Grid.Column="4" Classes="dim" Text="fade (s)" VerticalAlignment="Center"
                   Margin="16,0,6,0" />
        <NumericUpDown Grid.Column="5" Width="120" Minimum="1" Maximum="120" Increment="1"
                       FormatString="0" ParsingNumberStyle="Integer"
                       Value="{Binding CrossfadeSeconds}"
                       ToolTip.Tip="How long before the end the fade starts, and how long it lasts." />

        <TextBlock Grid.Column="6" Classes="time" Margin="20,0,0,0"
                   Text="{Binding ClockText}" VerticalAlignment="Center" />

        <!-- Headphone cue -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="7" Orientation="Horizontal"
                    Spacing="8" Margin="0,8,0,0">
          <TextBlock Classes="dim" Text="headphones" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding CueModes}" SelectedItem="{Binding CueMode}" MinWidth="110"
                    ToolTip.Tip="Off: normal stereo. Split: room mix on the left, headphones on the right, for a splitter cable. Device: headphones on a second output." />
          <ComboBox ItemsSource="{Binding CueDevices}" SelectedItem="{Binding CueDevice}" MinWidth="220"
                    IsVisible="{Binding IsCueDeviceMode}"
                    ToolTip.Tip="The output your headphones are plugged into" />
          <TextBlock Classes="dim" Text="cue" VerticalAlignment="Center" Margin="16,0,0,0" />
          <Slider Minimum="0" Maximum="1" Width="160" Value="{Binding CueMix}"
                  ToolTip.Tip="What the headphones hear: cued decks to the left, the room mix to the right" />
          <TextBlock Classes="dim" Text="master" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Library browser -->
    <Border Grid.Row="2" Classes="panel" Margin="0,10,0,0">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="heading" Text="LIBRARY" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Margin="16,0" Watermark="Search this folder and below…"
                   Text="{Binding SearchText}" />
          <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" />
          <Button Grid.Column="3" Content="Stop" Margin="6,0,0,0"
                  Command="{Binding CancelScanCommand}"
                  IsEnabled="{Binding IsScanning}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock Classes="dim" Text="BPM" VerticalAlignment="Center" />
            <NumericUpDown Classes="bpmfilter" Value="{Binding BpmMin}" PlaceholderText="from"
                           ToolTip.Tip="Lowest BPM to list. Leave both empty to list everything." />
            <TextBlock Classes="dim" Text="–" VerticalAlignment="Center" />
            <NumericUpDown Classes="bpmfilter" Value="{Binding BpmMax}" PlaceholderText="to"
                           ToolTip.Tip="Highest BPM to list" />
            <Button Classes="tiny" Content="≈" Command="{Binding MatchBpmCommand}"
                    ToolTip.Tip="List tracks within 6% of the playing deck's BPM" />
          </StackPanel>
          <CheckBox Grid.Column="5" Content="analyse BPM" Margin="12,0,0,0"
                    IsChecked="{Binding AnalyseLibraryBpm}"
                    ToolTip.Tip="Work out the BPM of every track in an opened folder, in the background" />
          <Button Grid.Column="6" Content="Save playlists" Margin="16,0,0,0"
                  Command="{Binding SavePlaylistsCommand}" />
          <Button Grid.Column="7" Content="Load playlists" Margin="6,0,0,0"
                  Command="{Binding LoadPlaylistsCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="260,10,*" Margin="0,10,0,0">
          <!-- Folder tree, expanded lazily -->
          <TreeView ItemsSource="{Binding Roots}"
                    SelectedItem="{Binding SelectedFolder}">
            <TreeView.Styles>
              <!-- Without this the node's IsExpanded never fires, so children are
                   never loaded and the tree cannot be navigated. -->
              <Style Selector="TreeViewItem" x:DataType="vm:FolderNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" FontSize="12" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <!-- Tracks in the selected folder -->
          <Grid Grid.Column="2" RowDefinitions="*,Auto">
            <DataGrid ItemsSource="{Binding BrowserRows}"
                      SelectedItem="{Binding SelectedBrowserRow}"
                      IsReadOnly="True" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" CanUserSortColumns="True">
              <DataGrid.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:LibraryRow">
                  <Setter Property="Opacity" Value="{Binding RowOpacity}" />
                </Style>
              </DataGrid.Styles>
              <DataGrid.Columns>
                <DataGridTextColumn Header="✓" x:DataType="vm:LibraryRow" Binding="{Binding PlayedMark}" Width="34" />
                <DataGridTextColumn Header="Title" x:DataType="vm:LibraryRow" Binding="{Binding Track.Title}" Width="*" />
                <DataGridTextColumn Header="Artist" x:DataType="vm:LibraryRow" Binding="{Binding Track.Artist}" Width="180" />
                <DataGridTextColumn Header="Album" x:DataType="vm:LibraryRow" Binding="{Binding Track.Album}" Width="160" />
                <DataGridTextColumn Header="BPM" x:DataType="vm:LibraryRow" Binding="{Binding BpmText}"
                                    SortMemberPath="BpmSortKey" Width="70" />
                <DataGridTextColumn Header="Time" x:DataType="vm:LibraryRow" Binding="{Binding Track.DurationText}"
                                    SortMemberPath="Track.Duration" Width="70" />
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
              <Button Content="→ Deck A" Command="{Binding AddToDeckACommand}"
                      ToolTip.Tip="Add the selected track to deck A's playlist" />
              <Button Content="→ Deck B" Command="{Binding AddToDeckBCommand}"
                      ToolTip.Tip="Add the selected track to deck B's playlist" />
              <Rectangle Width="1" Fill="{StaticResource PanelBorder}" Margin="8,0" />
              <Button Content="A ⇢ B" Command="{Binding SendAToBCommand}"
                      ToolTip.Tip="Move deck A's selected track to deck B" />
              <Button Content="B ⇢ A" Command="{Binding SendBToACommand}"
                      ToolTip.Tip="Move deck B's selected track to deck A" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="2,8,2,0">
      <TextBlock Classes="dim" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" Height="3"
                   IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Classes="dim" Margin="16,0,0,0"
                 Text="{Binding AudioStatus}"
                 ToolTip.Tip="The audio backend and device in use" />
    </Grid>
  </Grid>
</UserControl>
