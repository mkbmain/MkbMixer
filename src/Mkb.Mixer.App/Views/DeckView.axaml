<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mkb.Mixer.App.ViewModels"
             xmlns:ctrl="using:Mkb.Mixer.App.Controls"
             xmlns:views="using:Mkb.Mixer.App.Views"
             x:Class="Mkb.Mixer.App.Views.DeckView"
             x:DataType="vm:DeckViewModel">
  <Border Classes="panel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

      <!-- Deck name, shuffle/repeat/cue toggles and the live/mute indicator -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Classes="heading" Text="{Binding Label}" VerticalAlignment="Center" />
        <ToggleButton Grid.Column="1" Classes="decktoggle" Content="⇄"
                      IsChecked="{Binding Shuffle}"
                      ToolTip.Tip="Shuffle: take a random track from this deck's queue" />
        <ToggleButton Grid.Column="2" Classes="decktoggle" Content="↻"
                      IsChecked="{Binding Repeat}"
                      ToolTip.Tip="Repeat: played tracks go back on the end of this deck's queue" />
        <ToggleButton Grid.Column="3" Classes="decktoggle" Content="CUE"
                      IsChecked="{Binding IsCued}" IsEnabled="{Binding IsCueAvailable}"
                      ToolTip.Tip="Send this deck to the headphones. Pick a headphone mode under the crossfader first." />
        <Button Grid.Column="4" Command="{Binding ToggleMuteCommand}"
                Background="Transparent" BorderThickness="0" Padding="6,2"
                ToolTip.Tip="Toggle mute for this deck">
          <TextBlock Text="{Binding MuteLabel}" FontSize="12" FontWeight="Bold"
                     Foreground="{Binding IsMuted, Converter={StaticResource MuteColour}}" />
        </Button>
      </Grid>

      <TextBlock Classes="nowplaying"
                 Text="{Binding NowPlaying}" ToolTip.Tip="{Binding NowPlaying}" />

      <!-- Waveform: click or drag anywhere to seek -->
      <ctrl:WaveformView Grid.Row="2" Name="Wave" Classes="deck"
                         Waveform="{Binding Waveform}"
                         Progress="{Binding Progress}" />

      <Grid Classes="times" ColumnDefinitions="Auto,*,Auto">
        <TextBlock Classes="time" Text="{Binding Elapsed}" />
        <TextBlock Grid.Column="2" Classes="time" Text="{Binding Remaining}" />
      </Grid>

      <!-- Transport plus the tempo slider -->
      <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Button Classes="transport" Content="▶" Command="{Binding PlayCommand}"
                ToolTip.Tip="Play" />
        <Button Grid.Column="1" Classes="transport" Content="❚❚" Margin="6,0,0,0"
                Command="{Binding PauseCommand}" ToolTip.Tip="Pause" />
        <Button Grid.Column="2" Classes="transport" Content="■" Margin="6,0,0,0"
                Command="{Binding StopCommand}" ToolTip.Tip="Stop" />

        <TextBlock Grid.Column="4" Classes="dim tempolabel" Text="tempo" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <Slider Grid.Column="5" Classes="tempo" Minimum="0.5" Maximum="1.5"
                TickFrequency="0.25" Value="{Binding Tempo}"
                ToolTip.Tip="Playback speed. Pitch is preserved." />
      </Grid>

      <!-- Playlist for this deck. The phone layout hides it here and shows it on
           its own tab instead. -->
      <views:PlaylistView Grid.Row="5" Classes="deckplaylist" Margin="0,12,0,0" />
    </Grid>
  </Border>
</UserControl>
