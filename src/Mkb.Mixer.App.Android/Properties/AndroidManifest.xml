<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<!-- Android 13+ grants audio files by media type. -->
	<uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
	<!-- Android 12 and older only have the broad storage permission. -->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<!-- The playback service: keeps the mix going with the screen off. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Android 10 alone has scoped storage without path access to media files;
	     this opts out there. Ignored from Android 11, where path access returns. -->
	<application android:label="MKB Mixer" android:icon="@mipmap/ic_launcher" android:requestLegacyExternalStorage="true" />
</manifest>
